{
  "name": "@sub/svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SUB for Svelte 5 (element types, registerAll), generated from @sub/core's custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "node ../../scripts/gen-frameworks.mjs svelte && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sub/core": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "devDependencies": {
    "svelte": "^5.0.0"
  }
}
