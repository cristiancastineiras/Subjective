{
  "name": "@sub/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/auto.js",
    "./src/auto.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "bin",
    "custom-elements.json",
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json && cem analyze",
    "icons": "node scripts/gen-icons.mjs",
    "theme-defaults": "node scripts/gen-theme-defaults.mjs",
    "test:unit": "node --test tests/theme.test.mjs tests/icons.test.mjs",
    "manifest": "cem analyze"
  },
  "dependencies": {
    "lit": "3.3.3",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@material-symbols/svg-400": "^0.49.0"
  },
  "bin": {
    "sub-theme": "./bin/sub-theme.mjs"
  },
  "customElements": "custom-elements.json"
}
