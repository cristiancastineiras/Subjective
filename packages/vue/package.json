{
  "name": "@sub/vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SUB for Vue 3 (components with props, emits and v-model), generated from @sub/core's custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "node ../../scripts/gen-frameworks.mjs vue && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sub/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "devDependencies": {
    "vue": "^3.5.0"
  }
}
